diff --git a/lib/pdf/sheetSource.ts b/lib/pdf/sheetSource.ts
new file mode 100644
index 0000000..a5f0e39
--- /dev/null
+++ b/lib/pdf/sheetSource.ts
@@ -0,0 +1,56 @@
+// Single data-source gate for the CVA sheet (print page, cva-pdf route, close
+// email). The builder (cvaFormData.ts) already hides a blind coffee at paint
+// time; this moves the same rule to the data source so the serialized payload
+// of /print never carries the name/roast of an unrevealed sample (S8-02,
+// F-informes-1). The owner is NOT exempt: identical to the builder.
+//
+// Pure module (only imports another pure module) so vitest can load it.
+
+import { coffeeDisplayName } from "@/lib/coffeeAnonymize";
+
+export interface SheetSampleSource {
+  revealed: boolean;
+  coffee: {
+    name: string;
+    deletedAt?: Date | string | null;
+    roastLevel?: string | null;
+  } | null;
+}
+
+export interface SheetSampleIdentity {
+  coffeeName: string | null;
+  roastLevel: string | null;
+}
+
+/** Name + roast of the coffee, only when the sample is revealed. `deletedLabel`
+ *  is the localized "Café eliminado". */
+export function sheetSampleIdentity(
+  sample: SheetSampleSource,
+  deletedLabel: string,
+): SheetSampleIdentity {
+  if (!sample.revealed || !sample.coffee) return { coffeeName: null, roastLevel: null };
+  return {
+    coffeeName: coffeeDisplayName(sample.coffee, deletedLabel),
+    roastLevel: sample.coffee.roastLevel ?? null,
+  };
+}
+
+/** Per-sample owner-authored records: physical only for the owner view,
+ *  extrinsic for the owner view or once the sample is revealed. */
+export function sheetSampleRecords(
+  sample: {
+    revealed: boolean;
+    physical: { data: unknown } | null | undefined;
+    extrinsic: { data: unknown } | null | undefined;
+  },
+  ownerView: boolean,
+): { physical: Record<string, unknown>; extrinsic: Record<string, unknown> } {
+  const asRecord = (v: unknown): Record<string, unknown> =>
+    typeof v === "object" && v !== null && !Array.isArray(v)
+      ? (v as Record<string, unknown>)
+      : {};
+  return {
+    physical: ownerView ? asRecord(sample.physical?.data) : {},
+    extrinsic: ownerView || sample.revealed ? asRecord(sample.extrinsic?.data) : {},
+  };
+}
diff --git a/lib/reports/sampleGate.ts b/lib/reports/sampleGate.ts
new file mode 100644
index 0000000..5dcc950
--- /dev/null
+++ b/lib/reports/sampleGate.ts
@@ -0,0 +1,29 @@
+// Viewer gate for the per-sample payload of the results page (S8-02,
+// F-resultados-2). The UI already hid these two things; this stops the server
+// from serializing them in the first place:
+//  - `physical` (green-bean sheet) is per-sample and owner-authored: owner /
+//    super-admin lens only.
+//  - the community aggregate of a GROUP session while results are hidden
+//    (canViewGroupResults false). Solo sessions keep the trigger-row fallback.
+// Pure module: no scoring maths, nothing imported.
+
+export interface SampleGateContext {
+  ownerRead: boolean;
+  isGroup: boolean;
+  canViewGroup: boolean;
+}
+
+/** True when a group session's community numbers must not leave the server. */
+export function communityHidden(ctx: SampleGateContext): boolean {
+  return ctx.isGroup && !ctx.canViewGroup;
+}
+
+export function gateSampleForViewer<A>(
+  input: { physical: Record<string, unknown>; aggregateScore: A | null },
+  ctx: SampleGateContext,
+): { physical: Record<string, unknown>; aggregateScore: A | null } {
+  return {
+    physical: ctx.ownerRead ? input.physical : {},
+    aggregateScore: communityHidden(ctx) ? null : input.aggregateScore,
+  };
+}
diff --git a/tests/sheetSource.test.ts b/tests/sheetSource.test.ts
new file mode 100644
index 0000000..db098a4
--- /dev/null
+++ b/tests/sheetSource.test.ts
@@ -0,0 +1,76 @@
+import { describe, it, expect } from "vitest";
+import { sheetSampleIdentity, sheetSampleRecords } from "@/lib/pdf/sheetSource";
+
+const coffee = { name: "Geisha", roastLevel: "Light", deletedAt: null };
+
+describe("sheetSampleIdentity", () => {
+  it("hides name and roast while unrevealed", () => {
+    expect(sheetSampleIdentity({ revealed: false, coffee }, "X")).toEqual({
+      coffeeName: null,
+      roastLevel: null,
+    });
+  });
+  it("shows them once revealed", () => {
+    expect(sheetSampleIdentity({ revealed: true, coffee }, "X")).toEqual({
+      coffeeName: "Geisha",
+      roastLevel: "Light",
+    });
+  });
+  it("revealed without a coffee gives nulls", () => {
+    expect(sheetSampleIdentity({ revealed: true, coffee: null }, "X")).toEqual({
+      coffeeName: null,
+      roastLevel: null,
+    });
+  });
+  it("revealed anonymized coffee shows the deleted label and keeps roast", () => {
+    const r = sheetSampleIdentity(
+      { revealed: true, coffee: { name: "", deletedAt: new Date(), roastLevel: "Dark" } },
+      "Café eliminado",
+    );
+    expect(r).toEqual({ coffeeName: "Café eliminado", roastLevel: "Dark" });
+  });
+  it("unrevealed anonymized coffee shows nothing, not even the label", () => {
+    const r = sheetSampleIdentity(
+      { revealed: false, coffee: { name: "", deletedAt: new Date(), roastLevel: "Dark" } },
+      "Café eliminado",
+    );
+    expect(r).toEqual({ coffeeName: null, roastLevel: null });
+  });
+  it("blank name falls back to the label", () => {
+    expect(
+      sheetSampleIdentity({ revealed: true, coffee: { name: "" } }, "Fallback").coffeeName,
+    ).toBe("Fallback");
+  });
+  it("undefined roast becomes null", () => {
+    expect(sheetSampleIdentity({ revealed: true, coffee: { name: "A" } }, "X").roastLevel).toBeNull();
+  });
+});
+
+describe("sheetSampleRecords", () => {
+  const phys = { data: { phys_color: "green" } };
+  const ext = { data: { farm: "La Loma" } };
+  it("participant gets no physical and no extrinsic before reveal", () => {
+    expect(sheetSampleRecords({ revealed: false, physical: phys, extrinsic: ext }, false)).toEqual({
+      physical: {},
+      extrinsic: {},
+    });
+  });
+  it("participant gets extrinsic once revealed, never physical", () => {
+    expect(sheetSampleRecords({ revealed: true, physical: phys, extrinsic: ext }, false)).toEqual({
+      physical: {},
+      extrinsic: ext.data,
+    });
+  });
+  it("owner gets both, extrinsic even pre-reveal", () => {
+    expect(sheetSampleRecords({ revealed: false, physical: phys, extrinsic: ext }, true)).toEqual({
+      physical: phys.data,
+      extrinsic: ext.data,
+    });
+  });
+  it("null rows give empty records", () => {
+    expect(sheetSampleRecords({ revealed: true, physical: null, extrinsic: undefined }, true)).toEqual({
+      physical: {},
+      extrinsic: {},
+    });
+  });
+});
