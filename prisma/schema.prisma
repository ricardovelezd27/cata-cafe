generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                  String   @id
  displayName         String
  role                String   @default("cupping_pro")
  preferredLang       String   @default("es")
  avatarUrl           String?
  bio                 String?
  country             String?
  onboardingCompleted Boolean  @default(false)
  // Grants access to the /app/insights analytics area. Toggled only by the
  // super-admin (see lib/analytics/access.ts); the super-admin email itself
  // always has access regardless of this flag.
  analyticsAccess     Boolean  @default(false)
  createdAt           DateTime @default(now())

  cuppingSessions         CuppingSession[]
  coffees                 Coffee[]
  evaluations             Evaluation[]
  physicalEvals           PhysicalEvaluation[]
  extrinsicData           ExtrinsicData[]
  participants            SessionParticipant[]
  coffeeHistory           UserCoffeeHistory[]
  sessionInvites          SessionInvite[]
  savedInsights           SavedInsight[]
  tastingGroups           TastingGroup[]
  tastingGroupMemberships TastingGroupMember[]

  @@map("profiles")
}

model Coffee {
  id                 String    @id @default(cuid())
  name               String
  createdBy          String
  creator            Profile   @relation(fields: [createdBy], references: [id])
  country            String?
  region             String?
  farm               String?
  producer           String?
  species            String?
  variety            String?
  harvestYear        String?
  processType        String?
  altitude           String?
  roastLevel         String?
  certifications     String[]
  notes              String?
  isPublic           Boolean   @default(true)
  // When true, the community results section (scores, attribute averages,
  // flavor cloud) on the coffee profile page is visible to non-owners too.
  // Owners always see their own results regardless of this flag. Toggled via
  // setCoffeeResultsPublished (app/actions/coffees.ts).
  resultsPublished   Boolean   @default(false)
  resultsPublishedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessionSamples SessionSample[]
  coffeeHistory  UserCoffeeHistory[]

  @@index([createdBy])
  @@index([isPublic])
  @@map("coffees")
}

model CuppingSession {
  id            String    @id @default(cuid())
  name          String
  date          DateTime
  objective     String?
  format        String
  cupsPerSample Int       @default(5)
  isGroup       Boolean   @default(false)
  isAsync       Boolean   @default(false)
  status        String    @default("draft")
  createdBy     String
  createdByUser Profile   @relation(fields: [createdBy], references: [id])
  closesAt      DateTime?
  startedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  samples       SessionSample[]
  participants  SessionParticipant[]
  invites       SessionInvite[]
  coffeeHistory UserCoffeeHistory[]

  @@index([createdBy])
  @@index([createdBy, status])
  @@map("cupping_sessions")
}

model SessionSample {
  id        String         @id @default(cuid())
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coffeeId  String?
  coffee    Coffee?        @relation(fields: [coffeeId], references: [id])
  position  Int
  label     String
  revealed  Boolean        @default(false)
  createdAt DateTime       @default(now())

  evaluations    Evaluation[]
  physical       PhysicalEvaluation?
  extrinsic      ExtrinsicData?
  aggregateScore AggregateScore?

  @@unique([sessionId, position])
  @@index([coffeeId])
  @@map("session_samples")
}

model Evaluation {
  id              String        @id @default(cuid())
  sessionSampleId String
  sessionSample   SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  cupperId        String
  cupper          Profile       @relation(fields: [cupperId], references: [id])

  descriptiveData Json @default("{}")
  affectiveData   Json @default("{}")
  combinedData    Json @default("{}")

  nonUniformCups Boolean[] @default([])
  defectiveCups  Boolean[] @default([])
  defectTypes    String[]  @default([])

  affectiveSum    Float?
  rawScore        Float?
  individualScore Float?

  isDraft     Boolean   @default(true)
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  coffeeHistory UserCoffeeHistory[]

  @@unique([sessionSampleId, cupperId])
  @@index([cupperId])
  @@index([sessionSampleId, isDraft])
  @@map("evaluations")
}

model PhysicalEvaluation {
  id              String        @id @default(cuid())
  sessionSampleId String        @unique
  sessionSample   SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  evaluatedBy     String
  evaluator       Profile       @relation(fields: [evaluatedBy], references: [id])
  data            Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([evaluatedBy])
  @@map("physical_evaluations")
}

model ExtrinsicData {
  id              String        @id @default(cuid())
  sessionSampleId String        @unique
  sessionSample   SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  data            Json          @default("{}")
  revealedBy      String?
  revealedByUser  Profile?      @relation(fields: [revealedBy], references: [id])
  revealedAt      DateTime?

  @@index([revealedBy])
  @@map("extrinsic_data")
}

model SessionParticipant {
  sessionId           String
  session             CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId              String
  user                Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              String         @default("invited") // "invited" | "joined" | "owner"
  // Master can exclude a participant's data from group aggregates, descriptor
  // frequency and charts. Authoritative for the aggregate trigger (see
  // prisma/sql/rls_and_triggers.sql Phase 4). The participant still sees their own results.
  excludedFromResults Boolean        @default(false) @map("excluded_from_results")
  joinedAt            DateTime       @default(now())

  @@id([sessionId, userId])
  @@index([userId, status])
  @@map("session_participants")
}

model AggregateScore {
  id                String        @id @default(cuid())
  sessionSampleId   String        @unique
  sessionSample     SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  participantCount  Int           @default(0)
  submittedCount    Int           @default(0)
  cupsPerSample     Int           @default(0)
  totalCups         Int           @default(0)
  avgRawScore       Float?
  totalNonUniform   Int           @default(0)
  totalDefective    Int           @default(0)
  uniformityPenalty Float         @default(0)
  defectPenalty     Float         @default(0)
  communityScore    Float?
  attrAverages      Json          @default("{}")
  computedAt        DateTime      @default(now())

  @@map("aggregate_scores")
}

model UserCoffeeHistory {
  id              String         @id @default(cuid())
  userId          String
  user            Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coffeeId        String
  coffee          Coffee         @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  evaluationId    String
  evaluation      Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  sessionId       String
  session         CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  individualScore Float?
  communityScore  Float?
  tastedAt        DateTime
  createdAt       DateTime       @default(now())

  @@unique([userId, coffeeId, sessionId])
  @@index([userId])
  @@index([coffeeId])
  @@index([sessionId])
  @@map("user_coffee_history")
}

model SessionInvite {
  id        String         @id @default(cuid())
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token     String         @unique
  maxUses   Int?
  useCount  Int            @default(0)
  expiresAt DateTime?
  createdBy String
  creator   Profile        @relation(fields: [createdBy], references: [id])
  createdAt DateTime       @default(now())

  @@index([sessionId])
  @@index([createdBy])
  @@map("session_invites")
}

model SavedInsight {
  id        String   @id @default(cuid())
  name      String
  config    Json
  createdBy String
  creator   Profile  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdBy])
  @@map("saved_insights")
}

// Third-party reference data (imported via scripts/import-*.ts, server-read-only;
// RLS deny-all — see prisma/sql/rls_and_triggers.sql Phase 8).
model ReferenceSeries {
  id          String @id @default(cuid())
  source      String // "owid_fao" | "usda_psd"
  metric      String // "production" | "exports" | "domestic_consumption" ...
  countryCode String // ISO2, via COFFEE_COUNTRIES in lib/analytics/normalize.ts
  year        Int
  value       Float
  unit        String

  @@unique([source, metric, countryCode, year])
  @@index([countryCode, metric])
  @@map("reference_series")
}

model BenchmarkLot {
  id             String  @id @default(cuid())
  source         String  @default("cqi_arabica")
  countryCode    String? // normalized ISO2; null when unmatched
  countryRaw     String
  region         String?
  variety        String?
  processType    String? // canonical PROCESS_TYPES value
  processRaw     String?
  altitudeM      Int?
  harvestYear    Int?
  totalCupPoints Float
  attributes     Json    @default("{}")

  @@index([countryCode])
  @@index([processType])
  @@map("benchmark_lots")
}

// AI-narrative cache: repeat views of the same data never re-bill the AI API.
// dataHash = sha256(canonical inputs + locale + PROMPT_VERSION); see lib/ai/narratives.ts.
model InsightNarrative {
  id        String   @id @default(cuid())
  kind      String // "dashboard" | "insight" | "linkedin" | "digest"
  dataHash  String
  locale    String
  content   Json
  model     String
  createdAt DateTime @default(now())

  @@unique([kind, dataHash])
  @@map("insight_narratives")
}

// One row per monthly insights digest actually processed — the idempotency
// gate for the /api/cron/insights-digest route (safe retries/manual re-runs).
model DigestRun {
  id         String   @id @default(cuid())
  period     String   @unique // "YYYY-MM" (previous calendar month)
  recipients Int
  sent       Int
  aiSkipped  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("digest_runs")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      String   @default("pro")
  locale    String   @default("es")
  source    String   @default("landing")
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

model TastingGroup {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  owner     Profile  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TastingGroupMember[]

  @@index([createdBy])
  @@map("tasting_groups")
}

model TastingGroupMember {
  id          String       @id @default(cuid())
  groupId     String
  group       TastingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email       String
  userId      String?
  user        Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String?
  createdAt   DateTime     @default(now())

  @@unique([groupId, email])
  @@index([groupId])
  @@index([userId])
  @@map("tasting_group_members")
}

// Per-user daily AI-chat cost governor. One row per (user, UTC day); written
// only by app/actions/aiChat.ts behind requireAiAdmin(). Deny-all RLS with no
// policies (Prisma's postgres role bypasses RLS) — see
// prisma/sql/rls_and_triggers.sql Phase 12.
model AiChatUsage {
  id            String   @id @default(cuid())
  userId        String
  day           String // "YYYY-MM-DD" (UTC)
  questionCount Int      @default(0)
  modelCalls    Int      @default(0)
  promptTokens  Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
  @@map("ai_chat_usage")
}
