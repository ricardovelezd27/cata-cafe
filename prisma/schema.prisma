generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                  String   @id
  displayName         String
  role                String   @default("cupping_pro")
  preferredLang       String   @default("es")
  avatarUrl           String?
  bio                 String?
  country             String?
  onboardingCompleted Boolean  @default(false)
  // Grants access to the /app/insights analytics area. Toggled only by the
  // super-admin (see lib/analytics/access.ts); the super-admin email itself
  // always has access regardless of this flag.
  analyticsAccess     Boolean  @default(false)
  createdAt           DateTime @default(now())

  cuppingSessions         CuppingSession[]
  coffees                 Coffee[]
  evaluations             Evaluation[]
  physicalEvals           PhysicalEvaluation[]
  extrinsicData           ExtrinsicData[]
  participants            SessionParticipant[]
  coffeeHistory           UserCoffeeHistory[]
  sessionInvites          SessionInvite[]
  savedInsights           SavedInsight[]
  tastingGroups           TastingGroup[]
  tastingGroupMemberships TastingGroupMember[]
  coffeeShares            CoffeeShare[]
  coffeeInvites           CoffeeInvite[]
  groupPosts              GroupPost[]
  warmupReflections       WarmupReflection[]

  @@map("profiles")
}

model Coffee {
  id                 String    @id @default(cuid())
  // Short human-shareable code (6 chars from A-Z/2-9 minus lookalikes, stored
  // bare e.g. "K7M3FP", displayed "K7M-3FP") — the external identifier
  // roasters quote to each other. Generated via lib/coffeeCode.ts at every
  // create path; nullable until the backfill script stamps legacy rows
  // (scripts/backfill-coffee-codes.ts).
  code               String?   @unique
  name               String
  createdBy          String
  creator            Profile   @relation(fields: [createdBy], references: [id])
  country            String?
  region             String?
  farm               String?
  producer           String?
  species            String?
  variety            String?
  harvestYear        String?
  processType        String?
  altitude           String?
  roastLevel         String?
  certifications     String[]
  notes              String?
  // "private" | "shared" | "public". CoffeeShare rows grant access only while
  // visibility = "shared" (switching to private keeps them but makes them
  // inert); CoffeeInvite tokens are honored only while not private.
  visibility         String    @default("private")
  // When true, the community results section (scores, attribute averages,
  // flavor cloud) on the coffee profile page is visible to non-owners too.
  // Owners always see their own results regardless of this flag. Toggled via
  // setCoffeeResultsPublished (app/actions/coffees.ts).
  resultsPublished   Boolean   @default(false)
  resultsPublishedAt DateTime?
  // Anonymizing soft delete (2026-09-26). Set by deleteCoffees
  // (app/actions/coffees.ts): identifying fields (name, code, farm, producer,
  // notes, certifications) are wiped, shares/invites removed, and the row is
  // hidden by usableCoffeeWhere. Evaluations, aggregate scores, session samples
  // and user_coffee_history keep pointing here so tasting-derived data stays
  // linked to the analytical attributes (country, variety, process…).
  deletedAt          DateTime?
  // S10 WP5a (F-cafes-9): when an ORIGIN field last changed (lib/coffeeOrigin.ts).
  // NULL = no origin edit recorded. Stamped only by updateCoffee and
  // updateSampleMetadata when an origin field really differs; never by publish,
  // visibility, invites, claim, anonymize or code backfill. Display-only.
  originEditedAt     DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessionSamples SessionSample[]
  coffeeHistory  UserCoffeeHistory[]
  shares         CoffeeShare[]
  invites        CoffeeInvite[]

  @@index([createdBy])
  @@index([visibility])
  @@index([deletedAt])
  @@map("coffees")
}

model CoffeeShare {
  coffeeId  String
  coffee    Coffee   @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([coffeeId, userId])
  @@index([userId])
  @@map("coffee_shares")
}

model CoffeeInvite {
  id        String    @id @default(cuid())
  coffeeId  String
  coffee    Coffee    @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  token     String    @unique
  maxUses   Int?
  useCount  Int       @default(0)
  expiresAt DateTime?
  createdBy String
  creator   Profile   @relation(fields: [createdBy], references: [id])
  createdAt DateTime  @default(now())

  @@index([coffeeId])
  @@map("coffee_invites")
}

model CuppingSession {
  id            String        @id @default(cuid())
  name          String
  date          DateTime
  objective     String?
  format        String
  cupsPerSample Int           @default(5)
  isGroup       Boolean       @default(false)
  isAsync       Boolean       @default(false)
  status        String        @default("draft")
  createdBy     String
  createdByUser Profile       @relation(fields: [createdBy], references: [id])
  // Optional link to the standing tasting group this session belongs to
  // (Groups v2). Nullable — sessions can still be created without a group.
  // SetNull on group deletion so the session itself is never cascaded away.
  groupId       String?
  group         TastingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  closesAt      DateTime?
  /// IANA zone of the owner when `closesAt` was set (S8-05): "end of the day
  /// the owner picked" in THEIR zone. Null = UTC (legacy rows).
  closesAtZone  String?
  startedAt     DateTime?
  // Stamped by the single close routine (lib/closeSession.ts) — owner close,
  // solo auto-close and the daily cron all go through it. Null while active.
  closedAt      DateTime?
  /// Stamped when phase 2 of the close (reveal, aggregate refire, coffee
  /// history, close emails) finished. Null on a closed row = a repair is owed
  /// (lib/closeSession.ts finalizeClosedSession, cron repair pass). Backfilled
  /// to closedAt for sessions that were already closed. Never read by scoring.
  closeFinalizedAt DateTime? @db.Timestamptz(3)
  // The ONE sample the owner marks as "Referencia" (control sample the others
  // are compared against). Display-only: scoring and ranking never read it;
  // results show a client-side Δ against it (lib/referenceDelta.ts). SetNull
  // so removing that sample simply clears the mark. Named relation because it
  // is the second CuppingSession ↔ SessionSample link (the first is samples).
  referenceSampleId String?
  referenceSample   SessionSample? @relation("SessionReferenceSample", fields: [referenceSampleId], references: [id], onDelete: SetNull)
  /// S10 WP2 / B1: how the reference(s) behave. "anchor" (default, the
  /// pre-existing behaviour) pins the active reference's quality at 5 (79.00)
  /// for everyone; "free" lets everyone score it like any other sample. Fixed
  /// once the format is locked (before start / first evaluation). Gates ONLY the
  /// pin (lib/referenceRules.ts shouldPinReference); scoring, the trigger and
  /// AggregateScore never read it. Plain string like `format`/`status`.
  referenceMode String @default("anchor")
  // Optional pre-cupping warm-up ("Movimiento Sensorial"): a code constant
  // from lib/warmup/exercises.ts WARMUP_IDS, validated with oneOf() in the
  // session actions. Flow/display only — scoring and aggregates never read it.
  warmupExerciseId String?
  /// Master-led synced warm-up run (S6 warm-up v3 PR3): set by `startWarmup`
  /// (t0 of the player timeline = start of "Llega"), cleared by `stopWarmup`.
  /// TIMESTAMPTZ so the realtime payload carries its offset. Never read by
  /// scoring, aggregates or the trigger. Not copied by duplicateSession.
  warmupStartedAt DateTime? @db.Timestamptz(3)
  /// Owner closed new entries (S8-11 T6 / C4): a NEWCOMER's join link is
  /// refused with `entries_closed`; existing members re-enter. Display/gating
  /// only: never read by scoring, aggregates or the trigger.
  entriesLocked Boolean @default(false)
  /// S8-17 (C8): live group session linked to a tasting group whose owner
  /// asked to notify it; the email goes out from `startSession`. The group
  /// itself is `groupId`. Flow only: never read by scoring or the trigger.
  notifyGroupAtStart Boolean @default(false)
  /// Idempotence stamp of the group "new session" email (claimed before the
  /// send, cleared when the send fails). Not copied by duplicateSession.
  groupNotifiedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  samples              SessionSample[]
  participants         SessionParticipant[]
  invites              SessionInvite[]
  coffeeHistory        UserCoffeeHistory[]
  closeEmailDeliveries CloseEmailDelivery[]
  reminderDeliveries   SessionReminderDelivery[]

  @@index([createdBy])
  @@index([createdBy, status])
  @@index([groupId])
  @@index([referenceSampleId])
  @@map("cupping_sessions")
}

model SessionSample {
  id        String         @id @default(cuid())
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coffeeId  String?
  coffee    Coffee?        @relation(fields: [coffeeId], references: [id])
  position  Int
  label     String
  revealed  Boolean        @default(false)
  // Multi-reference (S6): null = not a reference; 1, 2, 3 = order named. referenceSampleId
  // on the session always points at the ACTIVE one (highest rank). Display-only.
  referenceRank Int?
  /// S10 WP2 / A9: optional per-sample preparation data, entered by the owner.
  /// BLIND DATA: a roast date or a preparation note can identify a coffee, so
  /// these four columns are owner-only until `revealed` (cup/results/PDF/print
  /// ship them only to the owner or once revealed) and are deliberately NOT in
  /// the PHASE 21 column GRANT (invisible to the browser key, like "coffeeId").
  /// Display-only: never read by scoring, the trigger or AggregateScore.
  roastDate         DateTime? @db.Date
  preparationNote   String?
  offProtocol       Boolean   @default(false)
  offProtocolNote   String?
  createdAt DateTime       @default(now())

  evaluations    Evaluation[]
  physical       PhysicalEvaluation?
  extrinsic      ExtrinsicData?
  aggregateScore AggregateScore?
  // Back-relation for CuppingSession.referenceSample. The FK lives on
  // cupping_sessions and is not unique, so Prisma needs a list (0 or 1 rows).
  referencedBy   CuppingSession[]    @relation("SessionReferenceSample")

  @@unique([sessionId, position])
  @@unique([sessionId, referenceRank])
  @@index([coffeeId])
  @@map("session_samples")
}

model Evaluation {
  id              String        @id @default(cuid())
  sessionSampleId String
  sessionSample   SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  cupperId        String
  cupper          Profile       @relation(fields: [cupperId], references: [id])
  // Denormalized from sessionSample.sessionId for server-side Realtime
  // filtering (avoids the postgres_changes filter length limit). Nullable so
  // old deployed code keeps working during rolling deploys; new writes always
  // set it and updates heal old NULL rows.
  sessionId String?

  descriptiveData Json @default("{}")
  affectiveData   Json @default("{}")
  combinedData    Json @default("{}")

  nonUniformCups Boolean[] @default([])
  defectiveCups  Boolean[] @default([])
  defectTypes    String[]  @default([])
  // Cups this evaluation covers; written on every save (computeEvaluationDerived).
  // NULL = scored before the 2026-11 rule (NOT backfilled, on purpose): the app
  // shows such a row under the old rule (lib/scoreRule.ts). The SQL trigger pools
  // these across a sample's included evaluations (PHASE 26), falling back to the
  // session's cupsPerSample while it is NULL.
  cups Int?

  affectiveSum    Float?
  rawScore        Float?
  individualScore Float?

  isDraft     Boolean   @default(true)
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  // S8-18: newest client edit time accepted for this row (ordering only; never
  // read by scoring, the trigger or AggregateScore).
  lastClientWriteAt DateTime? @db.Timestamptz(3)

  coffeeHistory UserCoffeeHistory[]

  @@unique([sessionSampleId, cupperId])
  @@index([cupperId])
  @@index([sessionSampleId, isDraft])
  @@index([sessionId])
  @@map("evaluations")
}

model PhysicalEvaluation {
  id              String        @id @default(cuid())
  sessionSampleId String        @unique
  sessionSample   SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  evaluatedBy     String
  evaluator       Profile       @relation(fields: [evaluatedBy], references: [id])
  data            Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([evaluatedBy])
  @@map("physical_evaluations")
}

model ExtrinsicData {
  id              String        @id @default(cuid())
  sessionSampleId String        @unique
  sessionSample   SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  data            Json          @default("{}")
  revealedBy      String?
  revealedByUser  Profile?      @relation(fields: [revealedBy], references: [id])
  revealedAt      DateTime?
  // S8-12: set when the owner corrects origin data AFTER the session closed, so
  // reports can say "Origen editado el <fecha>". Null = never edited post-close.
  editedAt        DateTime?     @map("edited_at") @db.Timestamptz(3)

  @@index([revealedBy])
  @@map("extrinsic_data")
}

model SessionParticipant {
  sessionId           String
  session             CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId              String
  user                Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              String         @default("invited") // "invited" | "joined" | "owner"
  // Master can exclude a participant's data from group aggregates, descriptor
  // frequency and charts. Authoritative for the aggregate trigger (see
  // prisma/sql/rls_and_triggers.sql Phase 4). The participant still sees their own results.
  excludedFromResults Boolean        @default(false) @map("excluded_from_results")
  // S8-12 exclusion trail: who/when/why. Stamped by setParticipantExclusion,
  // cleared on restore. excludedBy is a plain user id with NO foreign key (so
  // mergeGuestData / account deletion never have to touch it). Display-only.
  excludedAt          DateTime?      @map("excluded_at") @db.Timestamptz(3)
  excludedBy          String?        @map("excluded_by")
  exclusionReason     String?        @map("exclusion_reason") // sample_error | protocol | calibration | other
  joinedAt            DateTime       @default(now())

  @@id([sessionId, userId])
  @@index([userId, status])
  @@map("session_participants")
}

model AggregateScore {
  id                String        @id @default(cuid())
  sessionSampleId   String        @unique
  sessionSample     SessionSample @relation(fields: [sessionSampleId], references: [id], onDelete: Cascade)
  participantCount  Int           @default(0)
  submittedCount    Int           @default(0)
  cupsPerSample     Int           @default(0)
  totalCups         Int           @default(0)
  avgRawScore       Float?
  totalNonUniform   Int           @default(0)
  totalDefective    Int           @default(0)
  uniformityPenalty Float         @default(0)
  defectPenalty     Float         @default(0)
  communityScore    Float?
  attrAverages      Json          @default("{}")
  computedAt        DateTime      @default(now())
  // Rule this row was computed under: 1 = before 2026-11, 2 = the current rule.
  // The PHASE 26 trigger stamps 2 on every (re)computation; untouched rows stay 1.
  ruleVersion       Int           @default(1)

  @@map("aggregate_scores")
}

model UserCoffeeHistory {
  id              String         @id @default(cuid())
  userId          String
  user            Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NULL = a label-only row (S8-16): a coffee-less sample, or a never-revealed
  // sample whose session was deleted. Never link these to a coffee page and
  // exclude them from per-coffee aggregates (lib/historyDisplay.ts).
  coffeeId        String?
  coffee          Coffee?        @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  // A cupper's coffee history OUTLIVES the session it came from: deleting a
  // session detaches these rows (evaluation/session → NULL, `snapshot` filled
  // with the cupper's OWN evaluation + session metadata) instead of cascading
  // them away. See lib/coffeeHistory.ts detachCoffeeHistoryForSession.
  evaluationId    String?
  evaluation      Evaluation?    @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  sessionId       String?
  session         CuppingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  individualScore Float?
  communityScore  Float?
  tastedAt        DateTime
  // { v: 1, sessionName, format, date, cupsPerSample, sampleLabel,
  //   myEvaluation: { descriptive, affective, combined } } — only this
  // cupper's own data, never other participants'.
  snapshot        Json?
  detachedAt      DateTime?
  createdAt       DateTime       @default(now())

  // NOTE (S8-16): a PARTIAL unique index exists only in the migration
  // 20261111140000_history_coffee_optional — Prisma cannot express it:
  //   user_coffee_history_label_row_evaluation_key ON ("evaluationId")
  //   WHERE "coffeeId" IS NULL AND "evaluationId" IS NOT NULL
  // `prisma migrate dev` may propose dropping it. Never accept.
  @@unique([userId, coffeeId, sessionId])
  @@index([userId])
  @@index([coffeeId])
  @@index([sessionId])
  @@map("user_coffee_history")
}

// One row per (session, participant) close email. Makes sendCloseEmails
// idempotent: recipients with status "sent" are skipped on any re-run (double
// click, cron retry, owner "resend"), and the owner can see who got their PDF.
// status: "sent" | "skipped" (no email on file, e.g. anonymous guest) | "failed"
model CloseEmailDelivery {
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  status    String
  attempts  Int            @default(1)
  lastError String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@id([sessionId, userId])
  @@map("close_email_deliveries")
}

/// One row per session x recipient x reminder kind (S8-05): "deadline_24h" to
/// members with unsent work, "live_idle" to the owner of a forgotten live
/// session. System mail with its own ledger (never the user email budget).
/// userId is a plain String with NO Profile FK, same as CloseEmailDelivery, so
/// mergeGuestData has nothing to move (guests have no email, so no rows).
model SessionReminderDelivery {
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  kind      String
  sentAt    DateTime       @default(now())

  @@id([sessionId, userId, kind])
  @@map("session_reminder_deliveries")
}

model SessionInvite {
  id        String         @id @default(cuid())
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token     String         @unique
  maxUses   Int?
  useCount  Int            @default(0)
  expiresAt DateTime?
  createdBy String
  creator   Profile        @relation(fields: [createdBy], references: [id])
  createdAt DateTime       @default(now())
  /// false = revoked by "Regenerar enlace" (S8-11 T5). Inactive tokens read
  /// as expired on /join, joinViaToken and the print QR.
  active    Boolean        @default(true)

  @@index([sessionId])
  @@index([createdBy])
  @@map("session_invites")
}

// Private notes a person writes after a Movimiento Sensorial exercise (S10 WP7,
// Kim F2). One row per saved pair of answers. Readable ONLY by its owner: the
// table has RLS enabled with no policy and no API grant (PHASE 27), and the app
// reads it with Prisma scoped by userId (lib/warmup/reflectionsData.ts). No
// analytics query, admin view, export or AI prompt may ever read it.
model WarmupReflection {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Restrict)
  // One of WARMUP_IDS (lib/warmup/exercises.ts), validated on write.
  exerciseId String
  // Answers to the two closing questions; at least one is non-empty.
  feel       String?
  discovery  String?
  createdAt  DateTime @default(now())

  @@index([userId, exerciseId, createdAt])
  @@map("warmup_reflections")
}

model SavedInsight {
  id        String   @id @default(cuid())
  name      String
  config    Json
  createdBy String
  creator   Profile  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdBy])
  @@map("saved_insights")
}

// Third-party reference data (imported via scripts/import-*.ts, server-read-only;
// RLS deny-all — see prisma/sql/rls_and_triggers.sql Phase 8).
model ReferenceSeries {
  id          String @id @default(cuid())
  source      String // "owid_fao" | "usda_psd"
  metric      String // "production" | "exports" | "domestic_consumption" ...
  countryCode String // ISO2, via COFFEE_COUNTRIES in lib/analytics/normalize.ts
  year        Int
  value       Float
  unit        String

  @@unique([source, metric, countryCode, year])
  @@index([countryCode, metric])
  @@map("reference_series")
}

model BenchmarkLot {
  id             String  @id @default(cuid())
  source         String  @default("cqi_arabica")
  countryCode    String? // normalized ISO2; null when unmatched
  countryRaw     String
  region         String?
  variety        String?
  processType    String? // canonical PROCESS_TYPES value
  processRaw     String?
  altitudeM      Int?
  harvestYear    Int?
  totalCupPoints Float
  attributes     Json    @default("{}")

  @@index([countryCode])
  @@index([processType])
  @@map("benchmark_lots")
}

// AI-narrative cache: repeat views of the same data never re-bill the AI API.
// dataHash = sha256(canonical inputs + locale + PROMPT_VERSION); see lib/ai/narratives.ts.
model InsightNarrative {
  id        String   @id @default(cuid())
  kind      String // "dashboard" | "insight" | "linkedin" | "linkedin_pivot" | "digest"
  dataHash  String
  locale    String
  content   Json
  model     String
  createdAt DateTime @default(now())

  @@unique([kind, dataHash])
  @@map("insight_narratives")
}

// One row per monthly insights digest actually processed — the idempotency
// gate for the /api/cron/insights-digest route (safe retries/manual re-runs).
model DigestRun {
  id         String   @id @default(cuid())
  period     String   @unique // "YYYY-MM" (previous calendar month)
  recipients Int
  sent       Int
  aiSkipped  Boolean  @default(false)
  // S8-14: the period is CLAIMED first as "running", then marked "done" after
  // the sends. Rows from before this column are complete runs, hence the default.
  status     String   @default("done")
  // Per-recipient outcome { "<email>": "sent" | "failed" } (lib/digestClaim.ts).
  results    Json?
  createdAt  DateTime @default(now())

  @@map("digest_runs")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      String   @default("pro")
  locale    String   @default("es")
  source    String   @default("landing")
  createdAt DateTime @default(now())
  // S8-08: when and under which notice the person typed their address.
  // Null on rows created before the consent record existed.
  consentAt            DateTime?
  consentNoticeVersion String?

  @@map("waitlist_entries")
}

model TastingGroup {
  id          String   @id @default(cuid())
  name        String
  // Optional free-text description shown on the group's detail page and in
  // invitation emails (Groups v2).
  description String?
  createdBy   String
  owner       Profile  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  // Idempotency key posted by the create-group dialog (S8-03): a replayed
  // submit returns this group instead of creating a second one and re-sending
  // the invitations.
  clientKey   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TastingGroupMember[]
  sessions CuppingSession[]
  posts    GroupPost[]

  @@index([createdBy])
  @@map("tasting_groups")
}

// Announcements feed (groups "Facebook-lite"). Owner-only authorship for now —
// members read. `emailSent` records whether the optional notify-by-email blast
// fired for this post. Member reads go through Prisma (postgres role bypasses
// RLS) like every other group surface; RLS itself is owner-only (PHASE 17 in
// prisma/sql/rls_and_triggers.sql).
model GroupPost {
  id        String       @id @default(cuid())
  groupId   String
  group     TastingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String?
  body      String
  emailSent Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([groupId, createdAt])
  @@map("group_posts")
}

model TastingGroupMember {
  id          String       @id @default(cuid())
  groupId     String
  group       TastingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email       String
  userId      String?
  user        Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String?
  createdAt   DateTime     @default(now())
  // Set when the member unsubscribes from this group's emails (S8-20,
  // F-grupos-8). The owner re-adding the address (an upsert) never touches it.
  emailOptOutAt DateTime? @db.Timestamptz(3)

  emailDeliveries GroupEmailDelivery[]

  @@unique([groupId, email])
  @@index([groupId])
  @@index([userId])
  @@map("tasting_group_members")
}

// One row per RESERVED outbound email (S8-03). lib/emailBudget.ts counts these
// to throttle magic links and group mail before anything is sent. No user FK
// on purpose (mergeGuestData is untouched): actorKey is "u_<userId>" or an
// HMAC of the request IP, targetKey an HMAC of the lowercased address. Never a
// raw IP or address. RLS on, no policies (server-only via Prisma).
model OutboundEmailEvent {
  id         String   @id @default(cuid())
  kind       String // "magic_link" | "group_broadcast" | "group_invite"
  actorKey   String?
  targetKey  String?
  recipients Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([kind, actorKey, createdAt])
  @@index([kind, targetKey, createdAt])
  @@map("outbound_email_events")
}

// Per-recipient ledger of one group broadcast (S8-03), the close-email
// ledger's shape: "retry failed" resends only rows that are not "sent", and no
// recipient gets the same broadcast twice. lastError holds a code, never the
// provider's response body. RLS on, no policies.
model GroupEmailDelivery {
  broadcastId String
  memberId    String
  member      TastingGroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      String // "sent" | "skipped" | "failed"
  attempts    Int                @default(1)
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@id([broadcastId, memberId])
  @@index([memberId])
  @@map("group_email_deliveries")
}

// Per-user daily AI-chat cost governor. One row per (user, UTC day); written
// only by app/actions/aiChat.ts behind requireAiAdmin(). Deny-all RLS with no
// policies (Prisma's postgres role bypasses RLS) — see
// prisma/sql/rls_and_triggers.sql Phase 12.
model AiChatUsage {
  id            String   @id @default(cuid())
  userId        String
  day           String // "YYYY-MM-DD" (UTC)
  questionCount Int      @default(0)
  modelCalls    Int      @default(0)
  promptTokens  Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
  @@map("ai_chat_usage")
}
